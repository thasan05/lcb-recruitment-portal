# LinkedIn Community Bangladesh (LCB) Recruitment Portal
# Environment Variables Example Configuration

# Application URL (used for generating absolute candidate links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# HR Admin Credentials (for MVP direct authentication & initial setup)
ADMIN_EMAIL=hr@linkedincommunitybangladesh.com
ADMIN_PASSWORD=lcb_recruitment_2026!
ADMIN_SESSION_SECRET=super_secret_session_encryption_key_change_in_production
