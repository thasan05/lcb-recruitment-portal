# ====================================================================
# LinkedIn Community Bangladesh (LCB) Recruitment Portal
# Environment Variables Configuration Template
# 
# SECURITY NOTICE:
# - Copy this file to .env.local for local development. Never commit .env.local.
# - In production (Vercel), configure these in Project Settings > Environment Variables.
# - Variables prefixed with NEXT_PUBLIC_ are bundled into client code. NEVER put secrets there.
# ====================================================================

# Application Public URL (used for generating absolute candidate links in emails)
NEXT_PUBLIC_APP_URL=https://recruitment.linkedincommunitybangladesh.com

# Supabase Configuration
# NEXT_PUBLIC_SUPABASE_URL: Your project URL (e.g. https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Client-safe publishable key. RLS must be enabled to protect tables.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# SUPABASE_SERVICE_ROLE_KEY: SECRET server-only key. Never expose to client bundles.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# HR Admin Authentication
# ADMIN_USERNAME: Primary login identifier for HR administrators
ADMIN_USERNAME=admin

# ADMIN_PASSWORD: Strong password (minimum 16 characters recommended)
ADMIN_PASSWORD=your_strong_admin_password_here

# ADMIN_SESSION_SECRET: High-entropy secret for HMAC-SHA256 session signatures (min 32 characters).
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=your_random_64_character_hex_session_secret_here

# Email Dispatch Configuration (Resend or Gmail)
# Provider 1: Resend HTTP API (Recommended for production custom domain deliverability)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=LinkedIn Community Bangladesh <recruitment@linkedincommunitybangladesh.com>

# Provider 2: Gmail App Password / OAuth2 (Fallback)
GMAIL_USER=linkedincommunitybangladesh@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Development / Testing Mode
# When true, emails are simulated and logged to server console without sending
EMAIL_TEST_MODE=false
