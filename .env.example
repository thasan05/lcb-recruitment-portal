# LinkedIn Community Bangladesh (LCB) Recruitment Portal
# Environment Variables Example Configuration

# Application URL (used for generating absolute candidate links)
NEXT_PUBLIC_APP_URL=https://recruitment.linkedincommunitybangladesh.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# HR Admin Credentials (Username & Password)
ADMIN_USERNAME=admin
ADMIN_EMAIL=tanvirhasan.career@gmail.com
ADMIN_PASSWORD=your_admin_password_here
ADMIN_SESSION_SECRET=ca2e2bbdb3424904afda8af35edfadc42bcfd107480848228028f84140274f0e

# Resend Official Email Dispatch (Recommended - Verified Domain)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=LinkedIn Community Bangladesh <recruitment@linkedincommunitybangladesh.com>
GMAIL_USER=linkedincommunitybangladesh@gmail.com
EMAIL_TEST_MODE=false
